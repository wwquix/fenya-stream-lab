NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:5173

TWITCH_PROVIDER=mock
TWITCH_CHANNEL_LOGIN=fenya

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3001/auth/twitch/callback
# Optional extra browser-login scopes; user:read:chat is always included.
TWITCH_OAUTH_SCOPES=
AUTH_SUCCESS_REDIRECT_URI=http://localhost:5173/

# Required for EventSub chat. Keep real values only in the ignored local .env file.
TWITCH_USER_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

TWITCH_BROADCASTER_ID=
TWITCH_BOT_USER_ID=

TWITCH_POLL_INTERVAL_MS=30000
TWITCH_EVENTSUB_RECONNECT_MS=5000
TWITCH_LIVE_INGEST_AUTOSTART=false
TWITCH_TOKEN_REFRESH_ENABLED=false
TWITCH_TOKEN_REFRESH_INTERVAL_MS=300000
DATABASE_PATH=server/data/fenya-stream-lab.sqlite
# Required before storing Twitch user tokens. Use 32 random bytes encoded as hex or base64.
TOKEN_ENCRYPTION_KEY=
# Optional comma-separated allowlists. Channel ownership never grants platform admin.
PLATFORM_ADMIN_TWITCH_IDS=
PLATFORM_ADMIN_TWITCH_LOGINS=
MOCK_SAMPLER_INTERVAL_MS=10000
MOCK_SAMPLER_AUTOSTART=false
SUMMARY_PROVIDER=local
REPLAY_MS_PER_STREAM_MINUTE=250
